# Copy to .env and adjust. Never commit the real .env.

NEO4J_USER=neo4j
NEO4J_PASSWORD=synapse-local-dev

POSTGRES_DB=synapse_state
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse-local-dev

# Model ids on the QVAC node. MedPsy resolves via ./models/*.gguf or
# QVAC_MODEL_SOURCE; EMBED_MODEL defaults to a QVAC built-in constant
# (EmbeddingGemma 300M Q4, multilingual — verified to load). bge-m3 works
# only with a GGUF the QVAC embeddings addon accepts.
MEDPSY_MODEL=medpsy:q4_k_m
EMBED_MODEL=EMBEDDINGGEMMA_300M_Q4_0

# Phase 2 — Pear/HTTP URL to fetch a model from a peer on first start
# (e.g. a HuggingFace resolve URL or a pear:// address). Only applies to the
# model whose name appears in the URL; other models resolve from ./models
# (*.gguf) or the registry. Empty = local/registry only.
QVAC_MODEL_SOURCE=
# Example (bge-m3 GGUF via HuggingFace, fetched on first load, then cached):
#QVAC_MODEL_SOURCE=https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q4_K_M.gguf

# Phase 3 — node-to-node observation sync.
# SYNC_PEERS: comma-separated peer base URLs (e.g. http://node2:8000). Empty = sync off.
# SYNC_TOKEN: shared bearer token peers use on POST /api/sync/ingest.
#   Empty = endpoint closed (404). Set the same value on every node.
# SYNC_INTERVAL_S: outbox push interval.
SYNC_PEERS=
SYNC_TOKEN=
SYNC_INTERVAL_S=30

NUXT_PUBLIC_API_BASE=

# Data persistence root (bind mounts). Default: ./volumes next to the repo.
# On the big-drive server:
# VOLUMES_ROOT=/mnt/jboda/pedrito/volumes
VOLUMES_ROOT=./volumes

# Host port for the public gateway. Default 3000; on this dev machine
# port 3000 is taken by another project, so use e.g. 3001 here.
GATEWAY_PORT=3001

# Discord webhook for deployment notifications from
# scripts/git-pull-listener.sh (deploy start / success / failure).
# Leave empty to disable notifications.
DISCORD_DEPLOY_WEBHOOK=
