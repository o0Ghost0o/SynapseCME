# Copy to .env and adjust. Never commit the real .env.

NEO4J_USER=neo4j
NEO4J_PASSWORD=synapse-local-dev

POSTGRES_DB=synapse_state
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse-local-dev

# Model tags on the QVAC/Ollama node. Q4_K_M preferred for MedPsy.
MEDPSY_MODEL=medpsy:q4_k_m
EMBED_MODEL=bge-m3

NUXT_PUBLIC_API_BASE=

# Data persistence root (bind mounts). Default: ./volumes next to the repo.
# On the big-drive server:
# VOLUMES_ROOT=/mnt/jboda/pedrito/volumes
VOLUMES_ROOT=./volumes

# Host port for the public gateway. Default 3000; on this dev machine
# port 3000 is taken by another project, so use e.g. 3001 here.
GATEWAY_PORT=3001

# Discord webhook for deployment notifications from
# scripts/git-pull-listener.sh (deploy start / success / failure).
# Leave empty to disable notifications.
DISCORD_DEPLOY_WEBHOOK=
